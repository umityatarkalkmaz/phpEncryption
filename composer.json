{
    "name": "umityatarkalkmaz/encryption",
    "description": "Authenticated encryption for values you store or put in a URL",
    "type": "library",
    "keywords": [
        "encryption",
        "aead",
        "xchacha20",
        "libsodium",
        "url"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Umit Yatarkalkmaz",
            "email": "umityatarkalkmaz@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "UmitYatarkalkmaz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UmitYatarkalkmaz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
